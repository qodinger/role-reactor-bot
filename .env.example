# =============================================================================
# Role Reactor Bot Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT FEATURES
# =============================================================================

NODE_ENV=development
PERFORMANCE_MONITORING=false
MEMORY_THRESHOLD=768000000

# Server / API Config
API_PORT=3030
SERVE_STATIC=false
DOCKER_ENV=false
DOCKER_HEALTH_CHECK=true
HEALTH_CHECKS=true
REQUEST_LOGGING=true

# =============================================================================
# DISCORD CONFIGURATION (REQUIRED)
# =============================================================================

# Discord Bot Token [REQUIRED]
# Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID [REQUIRED]
DISCORD_CLIENT_ID=your_client_id_here

# Target Guild ID [OPTIONAL]
# If set, commands deploy only to this guild (faster for development)
DISCORD_GUILD_ID=your_guild_id_here

# Developer IDs [OPTIONAL]
# Comma-separated list of Discord user IDs for developer commands
DISCORD_DEVELOPERS=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI [OPTIONAL]
# Examples:
# - Atlas: mongodb+srv://username:password@cluster.mongodb.net/role-reactor-bot?retryWrites=true&w=majority
# - Local: mongodb://localhost:27017
# - Leave empty for local files only
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/role-reactor-bot?retryWrites=true&w=majority

# MongoDB Database Name [OPTIONAL]
# Default: role-reactor-bot
MONGODB_DB=role-reactor-bot

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Storage is automatically managed:
# - MongoDB when available (preferred)
# - Local files in ./data directory as fallback

# =============================================================================
# API RATE LIMITING & CORS
# =============================================================================

API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_API_KEY=your_internal_api_key_here
PUBLIC_URL=http://localhost:3030
BOT_URL=http://localhost:3000
# CORS Allowed Origins (comma-separated, optional - defaults to *)
# Examples:
#   CORS_ALLOWED_ORIGINS=https://rolereactor.xyz,https://www.rolereactor.xyz
#   CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_ORIGINS=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level [OPTIONAL]
# Options: ERROR, WARN, INFO, DEBUG
# Default: INFO
LOG_LEVEL=INFO

# Log File Path [OPTIONAL]
# If set, logs written to this file in addition to console
LOG_FILE=./logs/bot.log

# Enable Console Logging [OPTIONAL]
# Default: true
LOG_CONSOLE=true

# =============================================================================
# WEBSITE AUTHENTICATION (OPTIONAL)
# =============================================================================

# Discord OAuth2 Client Secret [OPTIONAL]
# Required for website Discord login
DISCORD_CLIENT_SECRET=your_client_secret_here

# Token Encryption Key [OPTIONAL]
# Required for encrypting OAuth tokens stored in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret safe - if lost, stored tokens cannot be decrypted
TOKEN_ENCRYPTION_KEY=your_64_character_hex_key_here

# Session Secret [OPTIONAL]
# Random string for session encryption
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_secret_here

# =============================================================================
# STREAMING INTEGRATION (OPTIONAL)
# =============================================================================
# Connect the bot to streaming platforms (Twitch, Kick, YouTube) so streamers
# can relay chat, post go-live alerts, and run stream commands from Discord.

# Enable Twitch integration [OPTIONAL]
# Default: false
TWITCH_STREAMING_ENABLED=false

# Twitch Application Client ID [OPTIONAL]
# Get from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here

# Twitch Application Client Secret [OPTIONAL]
# Get from https://dev.twitch.tv/console/apps (generate a new secret)
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# OAuth Redirect URI [REQUIRED if enabled]
# Must match exactly what is registered in the Twitch dev console.
# Must be HTTPS in production.
# Example: https://api.rolereactor.xyz/api/v1/stream/callback/twitch
TWITCH_REDIRECT_URI=https://api.rolereactor.xyz/api/v1/stream/callback/twitch

# Dedicated Twitch Bot Account Identity [OPTIONAL]
# Posts chat messages as the bot (e.g. twitch.tv/rolereactor)
TWITCH_BOT_USER_ID=your_twitch_bot_user_id_here
TWITCH_BOT_LOGIN=your_twitch_bot_login_here
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# Kick Integration [OPTIONAL]
KICK_STREAMING_ENABLED=false
KICK_CLIENT_ID=your_kick_client_id_here
KICK_CLIENT_SECRET=your_kick_client_secret_here
KICK_REDIRECT_URI=https://api.rolereactor.xyz/api/v1/stream/callback/kick

# YouTube Integration [OPTIONAL]
YOUTUBE_STREAMING_ENABLED=false
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=https://api.rolereactor.xyz/api/v1/stream/callback/youtube

# =============================================================================
# AI THRESHOLDS AND SETTINGS (OPTIONAL)
# =============================================================================

AI_USE_LONG_TERM_MEMORY=true
AI_CONVERSATION_STORAGE_TYPE=mongodb
AI_IMAGE_JOBS_STORAGE_TYPE=mongodb
AI_IMAGE_JOBS_RETENTION_DAYS=7
AI_CONVERSATION_HISTORY_LENGTH=20
AI_CONVERSATION_TIMEOUT=604800000
AI_MAX_CONVERSATIONS=1000

AI_STREAMING_ENABLED=false
AI_MAX_CONCURRENT=5
AI_REQUEST_TIMEOUT=300000
AI_USER_RATE_LIMIT=20
AI_USER_RATE_WINDOW=60000
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY=1000
AI_MAX_QUEUE_SIZE=100
AI_QUEUE_TIMEOUT=120000

OPENROUTER_MAX_CONCURRENT=10
STABILITY_MAX_CONCURRENT=5
RUNPOD_MAX_CONCURRENT=2
RUNPOD_ENABLED=false

# =============================================================================
# AI API KEYS (OPTIONAL)
# =============================================================================
# Provider selection and models are configured in src/config/ai.js
# At least one provider must be enabled for AI features to work

# OpenRouter API Key [OPTIONAL]
# Get from https://openrouter.ai/keys
# Provides access to OpenAI models (gpt-4o-mini) and others
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Brave Search API Key [OPTIONAL]
# Required for the AI web_search action (/ask can search the web when this is set)
# Get from https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Stability AI API Key [OPTIONAL]
# Get from https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here

# ComfyUI API Configuration [OPTIONAL]
# For ComfyICU: https://comfy.icu
# For self-hosted ComfyUI: http://127.0.0.1:8188
# For RunPod: Your RunPod proxy URL
COMFYUI_API_URL=https://comfy.icu
COMFYUI_API_KEY=your_comfyui_api_key_here

# RunPod Serverless Configuration [OPTIONAL]
# Get your API key from https://www.runpod.io/console/user/settings
# Get your endpoint ID from https://www.runpod.io/console/serverless
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# Civitai API Configuration [OPTIONAL]
# Enable NSFW anime image generation via Civitai
# Get API key from https://civitai.com/user/account (API Keys section)
# Buy Buzz credits at https://civitai.com/pricing (Yellow Buzz for NSFW content)
CIVITAI_ENABLED=true
CIVITAI_API_KEY=your_civitai_api_key_here

# =============================================================================
# IMAGE TOOLS CONFIGURATION (OPTIONAL)
# =============================================================================

# ILoveAPI Public Key [OPTIONAL]
# Required for web dashboard image tools (format, upscale, edit)
# Get from https://developer.ilovepdf.com/
ILOVEPDF_PUBLIC_KEY=your_ilovepdf_public_key_here
ILOVEPDF_SECRET_KEY=your_ilovepdf_secret_key_here

# =============================================================================
# PRICING CONFIGURATION (OPTIONAL - PROTECTS PROPRIETARY MARGINS)
# =============================================================================
# These values control your profit margins. Keep them secret in production.
# If not set, defaults are used (safe for development/testing).
#
# Text model costs are fetched automatically from OpenRouter API at startup.
# Image provider costs must be set here (they don't have public pricing APIs).

# Base conversion rate: 1 USD = X Core Credits
# Default: 15 (must match your storefront price)
PRICE_CONVERSION_RATE=15

# Platform markup multiplier (applied to API costs)
# 1.25 = 20% margin, 1.50 = 33% margin, 2.00 = 50% margin
# Default: 1.25
PRICE_PLATFORM_MARKUP=1.25

# Minimum charge per request (in Core credits)
# Default: 0.05
PRICE_MINIMUM_CHARGE=0.05

# Chat pricing bounds (Core credits)
# Default: min=0.01, max=0.05
PRICE_CHAT_MIN=0.01
PRICE_CHAT_MAX=0.05
PRICE_CHAT_FALLBACK=0.01

# Image pricing (Core credits)
# Default: min=0.05, fallback=0.1, default=5.0
PRICE_IMAGE_MIN=0.05
PRICE_IMAGE_FALLBACK=0.1
PRICE_IMAGE_DEFAULT=5.0

# Dynamic markup tiers (JSON array) - advanced pricing
# Format: [{"name":"tier","threshold":0.00005,"markup":200},...]
# Default: standard tier system (200x, 150x, 100x, 75x, 50x)
# PRICE_MARKUP_TIERS=
# PRICE_IMAGE_MARKUP_TIERS=

# Pricing cache TTL (ms) - how long to cache OpenRouter model prices
# Default: 3600000 (1 hour)
PRICE_CACHE_TTL_MS=3600000

# =============================================================================
# IMAGE PROVIDER COSTS (OPTIONAL - NO PUBLIC PRICING API)
# =============================================================================
# These providers don't have real-time pricing APIs, so costs are set here.
# Values are in Core Credits (what users are charged).

# Stability AI model costs
PRICE_STABILITY_LARGE=8.0
PRICE_STABILITY_LARGE_TURBO=5.0
PRICE_STABILITY_MEDIUM=4.0
PRICE_STABILITY_FLASH=5.0

# ComfyUI/self-hosted compute costs
PRICE_COMFYUI_DEFAULT=0.08

# RunPod serverless compute costs
PRICE_RUNPOD_DEFAULT=0.79

# Civitai API costs (per Buzz)
PRICE_CIVITAI_DEFAULT=0.01
PRICE_CIVITAI_ANIMAGINE=0.0068
PRICE_CIVITAI_ILLUSTRIOUS=0.0061
PRICE_CIVITAI_ANYTHING=0.005
PRICE_CIVITAI_PROTEUS=0.024

# OpenRouter fallback costs (used if real-time fetch fails)
# These should match what you pay - the system adds markup automatically
PRICE_OPENAI_GPT4O_MINI=0.08
PRICE_ANTHROPIC_SONNET=0.35
PRICE_DEEPSEEK_CHAT=0.08
PRICE_FLUX_FLEX=1.05
PRICE_FLUX_PRO=2.1

# Fallback cost-per-token estimates (USD)
PRICE_STABILITY_COST_PER_TOKEN=0.00002
PRICE_COMFYUI_COST_PER_REQUEST=0.001
PRICE_RUNPOD_COST_PER_REQUEST=0.01
PRICE_CIVITAI_COST_PER_IMAGE=0.006

# =============================================================================
# BULK DISCOUNTS (OPTIONAL)
# =============================================================================
PRICE_DISCOUNT_TIER1_THRESHOLD=1000
PRICE_DISCOUNT_TIER1=0.03
PRICE_DISCOUNT_TIER2_THRESHOLD=2500
PRICE_DISCOUNT_TIER2=0.05
PRICE_DISCOUNT_TIER3_THRESHOLD=5000
PRICE_DISCOUNT_TIER3=0.08

# =============================================================================
# LOYALTY REWARDS (OPTIONAL)
# =============================================================================
PRICE_LOYALTY_POINTS_PER_DOLLAR=1
PRICE_LOYALTY_TIER1_POINTS=100
PRICE_LOYALTY_TIER1_REWARD=3% bonus on next purchase
PRICE_LOYALTY_TIER2_POINTS=250
PRICE_LOYALTY_TIER2_REWARD=5% bonus on next purchase
PRICE_LOYALTY_TIER3_POINTS=500
PRICE_LOYALTY_TIER3_REWARD=8% bonus + priority support

# =============================================================================
# DYNAMIC PRICING (OPTIONAL)
# =============================================================================
# Peak/off-peak pricing multipliers
PRICE_PEAK_MULTIPLIER=1.2
PRICE_OFFPEAK_DISCOUNT=0.9

# =============================================================================
# PAYMENT INTEGRATIONS (OPTIONAL)
# =============================================================================
# PAYMENT INTEGRATIONS (OPTIONAL)
# =============================================================================

# top.gg Vote Webhook Auth Token & API Token [OPTIONAL]
# Get from https://top.gg/bot/YOUR_BOT_ID → Manage Bot → Webhook / API
# Required for automatic Core Credit rewards when users vote
# Install SDK: pnpm add @top-gg/sdk
TOPGG_WEBHOOK_AUTH=your_webhook_auth_token_here
TOPGG_API_TOKEN=your_topgg_api_token_here

# Website & Bot Domain URLs
WEBSITE_URL=http://localhost:8080
BOT_WEBSITE_URL=https://rolereactor.xyz

# Disable grace period Discord DMs - use dashboard notifications only
ALLOW_DM_WARNING=false

# Plisio Secret Key [OPTIONAL]
# Required for cryptocurrency payments
PLISIO_SECRET_KEY=your_plisio_secret_key_here

# Buy Me a Coffee Page URL [OPTIONAL]
# Required for BMAC payment integration
BUYMEACOFFEE_PAGE_URL=https://buymeacoffee.com/rolereactor

# Buy Me a Coffee Webhook Signing Secret [OPTIONAL]
# Required for webhook signature verification. Get from BMAC dashboard > Integrations > Webhook
BUYMEACOFFEE_WEBHOOK_SECRET=your_signing_secret_here

# Buy Me a Coffee API Token [OPTIONAL]
# Required for fetching supporter/subscription data for reconciliation
# Get from https://developers.buymeacoffee.com (token expires in ~6 months)
BUYMEACOFFEE_API_TOKEN=your_api_token_here
