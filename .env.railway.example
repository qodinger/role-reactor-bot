# =============================================================================
# Railway Environment Variables Reference
# =============================================================================
# Set these in: Railway Dashboard → your service → Variables tab
#
# DO NOT commit actual secrets. This file is a safe reference only.
# =============================================================================

# =============================================================================
# REQUIRED — Bot will NOT start without these
# =============================================================================

DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# MongoDB Atlas connection string
# Format: mongodb+srv://user:password@cluster.mongodb.net/role-reactor-bot
MONGODB_URI=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Set after first deploy — copy from Railway dashboard (Settings → Networking)
# Example: https://role-reactor-bot.up.railway.app
PUBLIC_URL=

# =============================================================================
# ENVIRONMENT (Railway sets NODE_ENV and PORT automatically)
# =============================================================================

NODE_ENV=production
HEALTH_CHECKS=true
DOCKER_HEALTH_CHECK=true
REQUEST_LOGGING=true
SERVE_STATIC=false
LOG_LEVEL=INFO
LOG_CONSOLE=true
MONGODB_DB=role-reactor-bot
PERFORMANCE_MONITORING=false

# =============================================================================
# DISCORD OAUTH (for web dashboard login)
# =============================================================================

DISCORD_CLIENT_SECRET=

# Your web dashboard URL (if you have a separate frontend)
BOT_URL=

# CORS allowed origins (comma-separated)
# Example: https://rolereactor.app,https://www.rolereactor.app
CORS_ALLOWED_ORIGINS=

# =============================================================================
# WEBHOOKS / PAYMENTS (Optional)
# =============================================================================

# From: https://top.gg/bot/YOUR_BOT_ID → Manage Bot → Webhook
TOPGG_WEBHOOK_AUTH=

# From: https://plisio.net/account
PLISIO_SECRET_KEY=

# =============================================================================
# AI SERVICES (Optional)
# =============================================================================

OPENROUTER_API_KEY=
STABILITY_API_KEY=
COMFYUI_API_URL=
COMFYUI_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENABLED=false

# =============================================================================
# OPTIONAL
# =============================================================================

# Comma-separated Discord user IDs for developer-only commands
DISCORD_DEVELOPERS=

API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
